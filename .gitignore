# GitHub에 올리지 않을 파일 목록 (.gitignore)
# 여기 적힌 파일·폴더는 git add를 해도 저장소에 들어가지 않습니다.

# 1) 비밀 정보
.env
.streamlit/secrets.toml

# 2) 기록 원본 (검수 전)
#    검수를 마친 정리본만 docs/records/ 에 복사해서 올립니다.
/records/

# 3) 개인 작업 문서
1차프로젝트_디자인_작업계획.md
1st_project_guide.md
파이썬용어복습.md

# 4) 사용성 테스트 웹 (베타·본 테스트용, 저장소에 올리지 않음)
test-web/
test-web_beta_*.zip
test-web_v*_*.zip
backups/
deploy/
deploy_site/

# 참고 이미지·작업 자료 (AI 생성 이미지, 푸터 시안 ref_image/footer_loop/ 포함 — 저장소에 올리지 않음, 11/2)
ref_image/

# 소개 페이지에 쓰지 않기로 한 세로 영상(54MB), 디자인 점검 도구(impeccable) 설정 (11/2)
arnolfini_ascii_scramble_9x16.mp4
.impeccable/

# 5) 운영체제·편집기·Python이 자동으로 만드는 파일
.DS_Store
Thumbs.db
__pycache__/
*.pyc
.vscode/
